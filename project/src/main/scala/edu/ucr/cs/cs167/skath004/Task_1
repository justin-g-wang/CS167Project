package edu.ucr.cs.cs167.jwang798

import edu.ucr.cs.bdlab.beast.geolite.{Feature, IFeature}
import org.apache.spark.SparkConf
import org.apache.spark.beast.SparkSQLRegistration
import org.apache.spark.rdd.RDD
import org.apache.spark.sql.{DataFrame, SparkSession}

object Task1 {
  def main(args: Array[String]): Unit = {
    // Initialize Spark context with increased memory
    val conf = new SparkConf()
      .setAppName("Task 1: Data Preparation")
      .set("spark.driver.memory", "4g")
      .set("spark.executor.memory", "4g")
      .set("spark.sql.shuffle.partitions", "200")

    if (!conf.contains("spark.master"))
      conf.setMaster("local[*]")

    val spark = SparkSession.builder().config(conf).getOrCreate()
    val sparkContext = spark.sparkContext
    SparkSQLRegistration.registerUDT()
    SparkSQLRegistration.registerUDF(spark)

    val inputFile: String = args(0)
    try {
      // Import Beast features
      import edu.ucr.cs.bdlab.beast._

      var birdData: DataFrame = spark.read.format("csv")
        .option("header", "true")
        .option("inferSchema", "true")
        .load(inputFile)

      // Keep specified columns and rename for easier processing
      birdData = birdData
        .select("x", "y", "GLOBAL UNIQUE IDENTIFIER", "CATEGORY", "COMMON NAME", "SCIENTIFIC NAME", "OBSERVATION COUNT", "OBSERVATION DATE")
        .withColumnRenamed("GLOBAL UNIQUE IDENTIFIER", "GLOBAL_UNIQUE_IDENTIFIER")
        .withColumnRenamed("COMMON NAME", "COMMON_NAME")
        .withColumnRenamed("SCIENTIFIC NAME", "SCIENTIFIC_NAME")
        .withColumnRenamed("OBSERVATION COUNT", "OBSERVATION_COUNT")
        .withColumnRenamed("OBSERVATION DATE", "OBSERVATION_DATE")

      // Cache the dataset to reduce recomputation
      birdData = birdData.cache()

      val birdRDD: SpatialRDD = birdData.selectExpr("*", "ST_CREATEPOINT(x, y) AS geometry").toSpatialRDD
      val zipRDD: SpatialRDD = sparkContext.shapefile("tl_2018_us_zcta510.zip").repartition(8) // Reduce memory load

      val birdZipRDD: RDD[(IFeature, IFeature)] = birdRDD.spatialJoin(zipRDD)

      // Final DataFrame with bird data and ZIP codes
      val birdZIP: DataFrame = birdZipRDD.map({ case (bird, zipcode) =>
        Feature.append(bird, zipcode.getAs[String]("ZCTA5CE10"), "ZIPCode")
      }).toDataFrame(spark).drop("geometry")

      birdZIP.printSchema()
      birdZIP.show(5)

      // Use repartition instead of coalesce
      birdZIP.coalesce(1).write.mode("overwrite").parquet("eBird_ZIP.parquet")

    } finally {
      spark.stop()
    }
  }
}
